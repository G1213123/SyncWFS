# Local application directory. The Cloud Run image uses /app.
APP_DIR=

# Optional executable overrides for local runs.
PYTHON_BIN=python3
NODE_BIN=node

# Cloud Storage destination.
GCS_BUCKET=road-sign-factory-asset
GCS_OBJECT=public/data/mvt/manifest.json

# Cloud Run deployment defaults used by deploy_cloud_run.ps1.
GOOGLE_CLOUD_PROJECT=
CLOUD_RUN_REGION=asia-east2
CLOUD_RUN_JOB=sync-wfs-vector-tiles
